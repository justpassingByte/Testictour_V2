# Copy to .env on VPS: cp .env.vps.example .env
# NEXT_PUBLIC_* are baked into frontend at BUILD time — rebuild frontend after changing them.

# ── Public URLs (browser + build args) ──
NEXT_PUBLIC_API_URL=https://api.testictour.com
NEXT_PUBLIC_BACKEND_URL=https://api.testictour.com
FRONTEND_URL=https://testictour.com

# ── Database (Docker internal network) ──
DATABASE_URL=postgresql://testictour_user:testictour_pass@postgres:5432/testictour_db

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string

# ── Optional: Stripe, Resend, MoMo, etc. ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
